# CoachPlan-Server und das Trainer-Konto, in dessen Bibliothek importiert wird.
# Diese Datei enthält ein Passwort: nicht einchecken, Rechte 600.
COACHPLAN_URL=https://coachplan.example.org
COACHPLAN_ANON_KEY=
COACHPLAN_EMAIL=
COACHPLAN_PASSWORD=

# Whisper: tiny, base, small, medium, large-v3 (größer = genauer, langsamer)
WHISPER_MODEL=small
# WHISPER_LANGUAGE=de
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16

# Optional: Cookie-Datei für yt-dlp, falls eine Plattform Anmeldung verlangt
# YTDLP_COOKIES=/pfad/zu/cookies.txt

# Optional, nur für "analyze": OpenAI-kompatible Chat-Schnittstelle
# LLM_URL=http://localhost:11434/v1
# LLM_MODEL=
# LLM_API_KEY=
